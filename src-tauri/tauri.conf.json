{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Transrator",
  "version": "0.2.0",
  "identifier": "com.ykworx.transrator",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "팝업 번역기",
        "width": 620,
        "height": 520,
        "minWidth": 520,
        "minHeight": 360,
        "visible": false,
        "decorations": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "windowEffects": {
          "effects": [
            "hudWindow"
          ],
          "state": "active"
        }
      }
    ],
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/tray.png",
      "iconAsTemplate": true,
      "tooltip": "Transrator - Cmd+Ctrl+T"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "vendor/whisper.cpp/models/for-tests-silero-v6.2.0-ggml.bin": "for-tests-silero-v6.2.0-ggml.bin",
      "vendor/silero-vad-coreml.mlmodelc/": "silero-vad-coreml.mlmodelc/"
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "Transrator Developer"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}